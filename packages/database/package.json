{
  "name": "@waypoint/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@waypoint/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --conditions=@waypoint/source src/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env --conditions=@waypoint/source src/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:"
  }
}
