# Copy to .env and replace every placeholder before deploying.

# Postgres (docker compose). POSTGRES_PORT is bound to 127.0.0.1 on the host only.
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=change-me
POSTGRES_DB=waypoint
POSTGRES_PORT=5432

# Used by pnpm dev / db:migrate / db:seed on the host.
# Containers override it to point at the db service.
DATABASE_URL=postgres://waypoint:change-me@localhost:5432/waypoint

# At least 32 characters; use 64 random characters in any shared environment.
SESSION_SECRET=change-me-to-64-random-characters-before-any-shared-deploy

# Caddy site address: http://localhost for plain HTTP, or a bare hostname for automatic HTTPS.
DOMAIN=http://localhost
# Host ports for the web container. Change them if something else already listens on 80/443.
HTTP_PORT=80
HTTPS_PORT=443

# Enables operating-clock control and seed reset. Never true in production.
DEMO_MODE=true
# Initial operating date (YYYY-MM-DD). Must fall inside calendar.csv.
# DEMO_DATE=

# Directory the seed reads the confidential source CSVs from (mounted read-only in compose).
DATA_DIR=/data

LOG_LEVEL=info
